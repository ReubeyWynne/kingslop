{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kingslop",
  "main": "src/index.js",
  "compatibility_date": "2025-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kingslop-vikings",
      "migrations_dir": "migrations",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "8374101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "8374102",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://dey.ci,https://www.dey.ci"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "observability": {
    "enabled": false
  }
}
